{% extends 'base.html.twig' %}

{% block title %}EasyLearning{% endblock %}

{% block body %}
{% include "partials/_hero.html.twig" %}
    {# Last formation #}
    <section class="mx-auto max-w-7xl py-12 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-light tracking-tight sm:text-4xl pb-7">Nos dernières formations</h2>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3 lg:gap-10">
            {# Cards #}
            {% for course in courses %}
                <article class="group overflow-hidden rounded-2xl bg-base-100 shadow-sm ring-1 ring-base-300 transition hover:-translate-y-1 hover:shadow-xl">
                    <figure class="relative overflow-hidden">
                        <img
                            src="{{ asset('images/formation/' ~ course.image) }}"
                            alt="Illustration de l'article {{ course.name }}"
                            class="h-64 w-full object-cover transition duration-500 group-hover:scale-105">
                        <span class="badge border-[#e8a33d] bg-[#e8a33d] text-white absolute left-4 top-4">
                            {{course.categoryId.name|upper }}
                      </span>

                    </figure>
                    <div class="p-6">
                        <div class="flex items-center gap-2 text-sm text-base-content/50">
                            {{ ux_icon('lucide:calendar', {class: 'h-4 w-4 ml-4'}) }}
                            <time datetime="{{ course.createdAt|date('Y-m-d') }}">
                                {{ course.createdAt|date('d/m/Y') }}
                            </time>
                        </div>
                        <h2 class="mt-3 text-2xl font-[600] tracking-tight">
                            {{ course.name|capitalize }}
                        </h2>
                        <span class="mt-3 inline-flex items-center gap-1 text-base-content/70">
                            {{ course.price }}
                            {{ ux_icon('tabler:currency-euro', {class: 'h-4 w-4'}) }}
                            {{ course.duration }}

                        </span>

                        <div class="mt-6">
                            <a
                                href="{{ path('app_course', {slug:course.slug}) }}"
                                class="btn btn-warning btn-sm text-white">
                                voir formation
                                {{ ux_icon('lucide:arrow-right', {class: 'h-4 w-4'}) }}
                            </a>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    </section>
{#actualités#}
    <section class="mx-auto my-10 max-w-6xl bg-base-200/60 px-6 py-8 sm:px-8">

        <h3 class="mb-8 text-3xl font-light">Nos dernières actualités</h3>

        {% if actualites is empty %}
            <p class="text-base-content/70">Aucune actualité publiée pour le moment.</p>
        {% else %}
            <div class="grid gap-8 md:grid-cols-2">
                {% for actualite in actualites %}

                    {# ===== Carte ===== #}
                    <article class="flex gap-4 rounded-md bg-base-100 p-6 shadow-sm">
                        <img src="{{ asset('images/formation/' ~ actualite.image) }}"
                             alt=""
                             class="h-10 w-10 shrink-0 object-contain"
                             loading="lazy">

                        <div class="flex flex-1 flex-col">
                            <h2 class="text-lg">
                                {{ actualite.name }} - {{ actualite.createdAt|date('d/m/Y') }}
                            </h2>
                            <p class="mt-2 text-sm leading-relaxed text-base-content/80">
                                {{ actualite.content }}
                            </p>
                            <button type="button"
                                    class="mt-4 self-end text-sm text-primary hover:underline"
                                    onclick="document.getElementById('news-modal-{{ actualite.id }}').showModal()">
                                Lire la suite...
                            </button>
                        </div>
                    </article>

                    {# ===== Fenêtre modale ===== #}
                    <dialog id="news-modal-{{ actualite.id }}" class="modal">
                        <div class="modal-box max-w-2xl rounded-sm p-0">

                            {# En-tête #}
                            <div class="flex items-center justify-between border-b border-base-300 px-5 py-4">
                                <h3 class="text-xl">{{ actualite.name }}</h3>
                                <form method="dialog">
                                    <button class="text-2xl leading-none text-base-content/50 hover:text-base-content"
                                            aria-label="Fermer">&times;</button>
                                </form>
                            </div>

                            {# Corps #}
                            <div class="px-5 py-5">
                                <time class="text-lg" datetime="{{ actualite.createdAt|date('Y-m-d') }}">
                                    {{ actualite.createdAt|date('d/m/Y') }}
                                </time>
                                <div class="mt-4 flex flex-col gap-6 sm:flex-row">
                                    <img src="{{ asset('images/formation/' ~ actualite.image) }}"
                                         alt="{{ actualite.name }}"
                                         class="h-24 w-24 shrink-0 object-contain">
                                    <div class="text-base-content/80">
                                        {{ actualite.content|raw }}
                                    </div>
                                </div>
                            </div>

                            {# Pied #}
                            <div class="flex justify-end border-t border-base-300 px-5 py-4">
                                <form method="dialog">
                                    <button class="btn btn-primary">Close</button>
                                </form>
                            </div>
                        </div>

                        {# Clic en dehors = fermeture #}
                        <form method="dialog" class="modal-backdrop"><button>fermer</button></form>
                    </dialog>

                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
