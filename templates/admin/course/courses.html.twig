{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des cours{% endblock %}
{% block page_title %}Gestion des cours{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_course_new') }}" class="btn btn-primary btn-sm">
        {{ ux_icon('lucide:plus', {class: 'size-4'}) }} Ajouter un cours
    </a>
{% endblock %}

{% block body %}
    <div class="overflow-x-auto rounded-box bg-base-100 shadow-sm">
        <table class="table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>{{ knp_pagination_sortable(pagination,"Nom",'c.name') }}</th>
                    <th>{{ knp_pagination_sortable(pagination,"Catégorie",'cat.name') }}</th>
                    <th>{{ knp_pagination_sortable(pagination,"Niveau",'l.name') }}</th>
                    <th>{{ knp_pagination_sortable(pagination,"Durée",'c.duration') }}</th>
                    <th>{{ knp_pagination_sortable(pagination,"Prix",'c.price') }}</th>
                    <th>Statut</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for course in pagination %}
                <tr class="hover">
                    <td>
                        {% if course.image %}
                            <img src="{{ asset('images/formation/' ~ course.image) }}" alt="" class="h-10 w-14 rounded object-cover">
                        {% else %}


                            <div class="flex h-10 w-14 items-center justify-center rounded bg-base-200 text-base-content/40">{{ ux_icon('lucide:image', {class: 'size-4'}) }}</div>
                        {% endif %}
                    </td>
                    <td class="font-medium">{{ course.name }}</td>
                    <td>{{ course.categoryId.name }}</td>
                    <td>{{ course.levelId.name }}</td>
                    <td>{{ course.duration }}</td>
                    <td>{{ course.price|number_format(2, ',', ' ') }} €</td>
                    <td>
                        <span class="badge {{ course.isPublished ? 'badge-success' : 'badge-ghost' }}">
                            {{ course.isPublished ? 'Publié' : 'Masqué' }}
                        </span>
                    </td>
                    <td>
                        <div class="flex justify-end gap-1">
                            <a href="{{ path('admin_course_edit', {id: course.id}) }}" class="btn btn-square btn-sm btn-primary" title="Modifier">{{ ux_icon('lucide:square-pen', {class: 'size-4'}) }}</a>

                            <form method="post" action="{{ path('admin_course_toggle', {id: course.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ course.id) }}">
                                <button class="btn btn-square btn-sm btn-warning" title="{{ course.isPublished ? 'Masquer' : 'Afficher' }}">
                                    {{ ux_icon(course.isPublished ? 'lucide:eye-off' : 'lucide:eye', {class: 'size-4'}) }}
                                </button>
                            </form>

                            <a href="{{ path('app_course', {slug: course.slug}) }}" class="btn btn-square btn-sm btn-success" title="Voir le cours sur le site" target="_blank">{{ ux_icon('lucide:external-link', {class: 'size-4'}) }}</a>

                            <form method="post" action="{{ path('admin_course_delete', {id: course.id}) }}" onsubmit="return confirm('Supprimer ce cours ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ course.id) }}">
                                <button class="btn btn-square btn-sm btn-error" title="Supprimer">{{ ux_icon('lucide:trash-2', {class: 'size-4'}) }}</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="py-10 text-center text-base-content/60">Aucun cours pour le moment. Ajoutez votre premier cours.</td></tr>
            {% endfor %}
            </tbody>
        </table>
        <div  class="flex justify-center mt-2">
            {% include 'admin/partials/_pagination.html.twig' %}
        </div>
    </div>

    
{% endblock %}
