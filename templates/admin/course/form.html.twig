
{% extends 'admin/base.html.twig' %}

{% block title %}
    {{ course.id ? 'Modifier le cours' : 'Ajouter un cours' }}

{% endblock %}

{% block body %}
    <section class=" max-w-4xl mx-auto">
        <div class="flex justify-between my-12">
            <h1 class="text-3xl font-light"> {{ course.id ? 'Modifier le cours' : 'Ajouter un cours' }}</h1>
            <a href="{{ path('admin_course_index') }}" class="btn btn-ghost"><- Retour aux cours  </a>
        </div>
        <div class="admin">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <input type="submit" value="{{ course.id ? 'Modifier le cours' : 'Ajouter le cours' }}" class="btn btn-primary text-white mt-4 w-[20rem]">
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
