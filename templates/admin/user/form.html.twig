{% extends 'base.html.twig' %}

{% block title %}
    Ajouter un utilisateur
{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto bg-grey-200 flex-wrap justify-items-center m-5 p-5">
        <div class="flex justify-between my-12">
            <h1 class="text-3xl font-light pb-4 text-center">Ajouter</h1>
            <a href="{{ path('admin_user_index') }}" class="btn btn-ghost"><- Retour aux utilisateurs  </a>
        </div>

        <div class="w-[50%] register">
            {{ form_errors(form) }}
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit" class="btn btn-primary mt-4 w-[20rem]">Ajouter</button>
            {{ form_end(form) }}
        </div>

    </div>
{% endblock %}
