{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}
{% block page_title %}Gestion des utilisateurs{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_user_new') }}" class="btn btn-primary btn-sm">
        {{ ux_icon('lucide:plus', {class: 'size-4'}) }} Ajouter un utilisateur
    </a>
{% endblock %}

{% block body %}
    <div class="overflow-x-auto rounded-box bg-base-100 shadow-sm">
        <table class="table">
            <thead>
            <tr>
                <th>Utilisateur</th>
                <th>Rôle</th>
                <th>Inscrit le</th>
                <th>Dernière connexion</th>
                <th>Statut</th>
                <th class="text-right">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for user in pagination %}
                {% set isAdmin = 'ROLE_ADMIN' in user.roles %}
                <tr class="hover {{ user.isDisabled ? 'opacity-60' }}">
                    <td>
                        <div class="flex items-center gap-3">
                            <div class="avatar {{ user.image ? '' : 'placeholder' }}">
                                {% if user.image %}
                                    <div class="w-10 rounded-full"><img src="{{ asset('images/users/' ~ user.image) }}" alt=""></div>
                                {% else %}
                                    <div class="w-10 rounded-full bg-neutral text-neutral-content">
                                        <span class="text-sm">{{ user.firstName|first|upper }}{{ user.lastName|first|upper }}</span>
                                    </div>
                                {% endif %}
                            </div>
                            <div>
                                <div class="font-medium">{{ user.firstName }} {{ user.lastName }}</div>
                                <div class="text-sm text-base-content/60">{{ user.email }}</div>
                            </div>
                        </div>
                    </td>
                    <td><span class="badge {{ isAdmin ? 'badge-primary' : 'badge-ghost' }}">{{ isAdmin ? 'Admin' : 'Utilisateur' }}</span></td>
                    <td class="whitespace-nowrap">{{ user.createdAt|date('d/m/Y') }}</td>
                    <td class="whitespace-nowrap">{{ user.lastLogAt ? user.lastLogAt|date('d/m/Y H:i') : 'Jamais' }}</td>
                    <td><span class="badge {{ user.isDisabled ? 'badge-error' : 'badge-success' }}">{{ user.isDisabled ? 'Désactivé' : 'Actif' }}</span></td>
                    <td>
                        <div class="flex justify-end gap-1">
                            {% if not isAdmin %}
                                <form method="post" action="{{ path('admin_user_promote', {id: user.id}) }}" onsubmit="return confirm('Promouvoir cet utilisateur administrateur ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('promote' ~ user.id) }}">
                                    <button class="btn btn-square btn-sm btn-primary" title="Promouvoir administrateur">
                                        {{ ux_icon('lucide:shield-check', {class: 'size-4'}) }}
                                    </button>
                                </form>
                            {% endif %}

                            {% if user.id != app.user.id %}
                                <form method="post" action="{{ path('admin_user_toggle', {id: user.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ user.id) }}">
                                    <button class="btn btn-square btn-sm btn-warning" title="{{ user.isDisabled ? 'Réactiver' : 'Désactiver' }}">
                                        {{ ux_icon(user.isDisabled ? 'lucide:eye' : 'lucide:eye-off', {class: 'size-4'}) }}
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="py-10 text-center text-base-content/60">Aucun utilisateur.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'admin/partials/_pagination.html.twig' %}
{% endblock %}
