{% extends 'base.html.twig' %}

{% block title %}
    Contact
{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto bg-grey-200 flex-wrap justify-items-center m-5 p-5">
        <h1 class="text-3xl font-light w-[50%] pb-4 text-center">Contact</h1>
        <div class="w-[50%] register">
            {{ form_errors(form) }}
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit" class="btn btn-primary mt-4 w-[20rem]">Envoyer</button>
            {{ form_end(form) }}
        </div>

    </div>
{% endblock %}
